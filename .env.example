# ShareOnWeb — environment variables
# Copy of the exact names used in DEPLOY.md. Set real values in the
# Vercel / Render dashboards; this file is only documentation.

# ── Vercel (app) ────────────────────────────────────────────────────────────
# Baked into the client bundle at BUILD time — set BEFORE deploying,
# and redeploy after any change.
NEXT_PUBLIC_RELAY_URL=https://shareonweb.onrender.com

# Read at RUNTIME by the server session registry and /api/relay-config.
RELAY_URL=https://shareonweb.onrender.com

# Shared secret between app and relay (must match Render's RELAY_KEY).
RELAY_KEY=

# Canonical site origin (used for metadata + OG image absolute URLs).
SITE_URL=https://shareonweb.vercel.app
# Alias accepted by the code:
# NEXT_PUBLIC_SITE_URL=https://shareonweb.vercel.app

# All URL variables are protocol-tolerant: bare hosts like
# "shareonweb.vercel.app" are auto-upgraded to https. Including the
# scheme is recommended but not required.

# ── Local dev only ──────────────────────────────────────────────────────────
# Resolved relative to prisma/schema.prisma. Not used by serverless hosts.
DATABASE_URL=file:../db/custom.db
